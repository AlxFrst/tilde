{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tilde",
  "version": "0.1.0",
  "identifier": "dev.tilde.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Tilde",
        "width": 1200,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "decorations": false,
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Tilde contributors",
    "copyright": "© 2026 Tilde contributors — MIT OR Apache-2.0",
    "category": "DeveloperTool",
    "shortDescription": "An SSH-first terminal: jump hosts, SFTP and a polished UI, free and open source.",
    "longDescription": "Tilde is a desktop terminal centred on SSH and SFTP. It reads your ~/.ssh/config as is, chains jump hosts, keeps secrets in the OS keyring, and adds files, an editor, previews and a system monitor next to your shells. No account, no telemetry.",
    "homepage": "https://github.com/AlxFrst/tilde",
    "license": "MIT OR Apache-2.0",
    "licenseFile": "../LICENSE-MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "French"],
        "displayLanguageSelector": false,
        "installerHooks": "windows/hooks.nsh"
      },
      "wix": {
        "language": ["en-US", "fr-FR"],
        "fragmentPaths": ["windows/explorer-menu.wxs"],
        "componentRefs": ["ExplorerMenuCleanup"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libayatana-appindicator3-1"]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIxRTIyREFCQTNEREQzQUUKUldTdTA5MmpxeTNpSWM5VDBVNGt6VU9wV01VWUpML2pjcTF0T1BsZVV2M2QxMVhhTmRrNy9iTGgK",
      "endpoints": ["https://github.com/AlxFrst/tilde/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
