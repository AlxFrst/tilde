---
source: crates/tilde-ssh-config/tests/corpus.rs
expression: "render(&cfg, &ctx)"
---
diagnostics:
  (none)

quoted:
  hostname: quoted.example.com
  port: 2200
  user: deploy user
  identity_files: [/home/alice/.ssh/key with spaces]
  identities_only: false
  proxy_jump: []
  proxy_command: -
  forward_agent: false
  local_forwards: [8080 -> localhost:80]
  remote_forwards: []
  user_known_hosts_files: [/home/alice/.ssh/known_hosts, /home/alice/.ssh/known_hosts2]
  server_alive_interval: -
  server_alive_count_max: -
  connect_timeout: -
  strict_host_key_checking: -

spaced:
  hostname: spaced.example.com
  port: 22
  user: alice
  identity_files: [/home/alice/.ssh/escaped space]
  identities_only: false
  proxy_jump: []
  proxy_command: -
  forward_agent: false
  local_forwards: []
  remote_forwards: []
  user_known_hosts_files: [/home/alice/.ssh/known_hosts, /home/alice/.ssh/known_hosts2]
  server_alive_interval: -
  server_alive_count_max: -
  connect_timeout: -
  strict_host_key_checking: yes

tabbed:
  hostname: tabbed.example.com
  port: 22
  user: alice
  identity_files: [/home/alice/.ssh/escaped space]
  identities_only: false
  proxy_jump: []
  proxy_command: -
  forward_agent: false
  local_forwards: []
  remote_forwards: []
  user_known_hosts_files: [/home/alice/.ssh/known_hosts, /home/alice/.ssh/known_hosts2]
  server_alive_interval: -
  server_alive_count_max: -
  connect_timeout: -
  strict_host_key_checking: yes

other:
  hostname: other.example.com
  port: 22
  user: alice
  identity_files: [/home/alice/.ssh/escaped space]
  identities_only: false
  proxy_jump: []
  proxy_command: -
  forward_agent: false
  local_forwards: []
  remote_forwards: []
  user_known_hosts_files: [/home/alice/.ssh/known_hosts, /home/alice/.ssh/known_hosts2]
  server_alive_interval: -
  server_alive_count_max: -
  connect_timeout: -
  strict_host_key_checking: yes

Upper:
  hostname: upper
  port: 2201
  user: alice
  identity_files: []
  identities_only: false
  proxy_jump: []
  proxy_command: -
  forward_agent: false
  local_forwards: []
  remote_forwards: []
  user_known_hosts_files: [/home/alice/.ssh/known_hosts, /home/alice/.ssh/known_hosts2]
  server_alive_interval: -
  server_alive_count_max: -
  connect_timeout: -
  strict_host_key_checking: -
