  strict_host_key_checking: -

gitlab-work:
  hostname: gitlab.com
  port: 22
  user: git
  identity_files: [/home/alice/.ssh/gitlab_work, /home/alice/.ssh/id_ed25519]
  identities_only: false
  proxy_jump: []
