---
source: crates/tilde-ssh-config/tests/corpus.rs
expression: "render(&cfg, &ctx)"
---
diagnostics:
  <corpus>/06-match.conf:27 : Match exec n'est pas pris en charge par Tilde : ce bloc ne s'appliquera jamais

jump:
  hostname: jump.corp.example
  port: 2022
  user: alice
  identity_files: []
  identities_only: false
  proxy_jump: []
  proxy_command: -
  forward_agent: false
  local_forwards: []
  remote_forwards: []
  user_known_hosts_files: [/home/alice/.ssh/known_hosts, /home/alice/.ssh/known_hosts2]
  server_alive_interval: 45
  server_alive_count_max: -
  connect_timeout: -
  strict_host_key_checking: -

wiki.corp:
  hostname: wiki.corp
  port: 22
  user: alice
  identity_files: []
  identities_only: false
  proxy_jump: [jump]
  proxy_command: -
  forward_agent: false
  local_forwards: []
  remote_forwards: []
  user_known_hosts_files: [/home/alice/.ssh/known_hosts, /home/alice/.ssh/known_hosts2]
  server_alive_interval: 45
  server_alive_count_max: -
  connect_timeout: -
  strict_host_key_checking: -

build-01:
  hostname: 10.1.2.3
  port: 2022
  user: alice
  identity_files: [/home/alice/.ssh/ci_alice]
  identities_only: false
  proxy_jump: [jump]
  proxy_command: -
  forward_agent: false
  local_forwards: []
  remote_forwards: []
  user_known_hosts_files: [/home/alice/.ssh/known_hosts, /home/alice/.ssh/known_hosts2]
  server_alive_interval: 45
  server_alive_count_max: -
  connect_timeout: 3
  strict_host_key_checking: -

build-02:
  hostname: 10.1.2.4
  port: 2022
  user: root
  identity_files: [/home/alice/.ssh/ci_alice]
  identities_only: false
  proxy_jump: [jump]
  proxy_command: -
  forward_agent: false
  local_forwards: []
  remote_forwards: []
  user_known_hosts_files: [/home/alice/.ssh/known_hosts, /home/alice/.ssh/known_hosts2]
  server_alive_interval: 45
  server_alive_count_max: -
  connect_timeout: 3
  strict_host_key_checking: -
